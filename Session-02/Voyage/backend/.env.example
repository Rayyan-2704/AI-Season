# Groq API key
GROQ_API_KEY=your_groq_api_key_here

# Secret key used to sign JWT tokens — use a long, random string in real use
JWT_SECRET=your_jwt_secret_here

# JWT algorithm (default is fine for this project)
JWT_ALGORITHM=HS256

# How long a login session stays valid, in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# SQLite database file path (relative to backend/)
DATABASE_URL=sqlite:///./Voyage.db

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173